# SignTalk AI v3 — environment template (PROJECT_CONTEXT Section 13).
# Copy to .env and fill in local values. NEVER commit a real .env (keys only
# live in .env; .env is gitignored). No Firebase: storage is SQLite and auth is
# guest mode (locked owner decision), so no service-account credential is used.

# --- Language model (sentence layer) ---
GEMINI_API_KEY=
# gemini-2.5-flash is live and cheap (verified Oct 2026). gemini-3.5-flash /
# gemini-3.1-flash also exist if you want newer; the name is an env var so it
# can be swapped without code changes when Google retires a model.
GEMINI_MODEL=gemini-2.5-flash
LLM_PROVIDER=gemini                    # gemini | none | ollama
LLM_TIMEOUT_SECONDS=4

# --- Speech-to-text (Direction B) ---
WHISPER_MODEL=small                    # small | base | tiny

# --- Optional emotion nudge ---
ENABLE_EMOTION=false

# --- Storage & auth (locked: SQLite + guest, NO Firebase) ---
STORAGE_BACKEND=sqlite                 # sqlite
AUTH_MODE=guest                        # guest

# --- Server ---
CORS_ORIGINS=http://localhost:5173     # Vite dev server origin
USE_GPU=auto                           # auto | cpu | cuda
