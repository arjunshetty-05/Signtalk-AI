# SignTalk AI — Backend environment variables
# Copy to .env and fill in real values. Never commit the real .env file.

# Gemini 2.0 Flash API key (nlp_correction.py primary NLP path)
GEMINI_API_KEY=your_gemini_api_key_here

# Google Cloud Translate API key (translation.py fallback on cache miss)
GOOGLE_TRANSLATE_API_KEY=your_google_translate_api_key_here

# Path to the Firebase service account JSON, mounted into the container
# (see docker-compose.yml) — used by firebase-admin for Auth verification,
# Firestore, and Storage.
FIREBASE_SERVICE_ACCOUNT_PATH=/run/secrets/firebase-service-account.json

# Firebase Storage bucket name (e.g. signtalk-ai.appspot.com)
FIREBASE_STORAGE_BUCKET=your-project.appspot.com

# CORS — the two allowed frontend origins (no wildcard in production)
CORS_ORIGIN_WEB=http://localhost:3000
CORS_ORIGIN_PROD=https://signtalk.vercel.app

# Rate limits (slowapi syntax, e.g. "30/minute")
RATE_LIMIT_PREDICTION=30/minute
RATE_LIMIT_READONLY=100/minute

# development | production
ENV=development
